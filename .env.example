# --- Store: the Postgres + pgvector database the ontology lives in ---
# Password: minimum 8 characters.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=auto_ontology

# --- Listen address of the backend and ingestion service (`python -m`) ---
# Loopback, because neither has a login. Inside a container set 0.0.0.0 and
# publish the port on 127.0.0.1 instead.
# BIND_HOST=127.0.0.1

# --- The one source database (Postgres only); more than one refuses to start ---
# Schemas and tables are scoped by ingest.yaml (see ingest.example.yaml).
CONNECTION_STRINGS=postgresql://user:password@localhost:5432/dbname

# --- Model endpoints ---
# Every triplet is <PREFIX>_ENDPOINT / <PREFIX>_API_KEY / <PREFIX>_MODEL. Any
# field left unset falls back to the matching DEFAULT_MODELS_ value, so one
# DEFAULT_MODELS_ triplet can serve them all.
DEFAULT_MODELS_API_KEY=nvapi-your-api-key-here
DEFAULT_MODELS_ENDPOINT=https://integrate.api.nvidia.com/v1
DEFAULT_MODELS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Main (reasoning) model. Also serves the SQL agent's generator.
REASONING_API_KEY=nvapi-your-api-key-here
REASONING_ENDPOINT=https://integrate.api.nvidia.com/v1
REASONING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Non-reasoning model: entity extraction and table filtering during retrieval.
NON_REASONING_API_KEY=nvapi-your-api-key-here
NON_REASONING_ENDPOINT=https://integrate.api.nvidia.com/v1
NON_REASONING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Embedding model. Set explicitly: unset fields would fall back to the
# DEFAULT_MODELS_ chat model above. Ingest and query must use the same one.
EMBED_API_KEY=nvapi-your-api-key-here
EMBED_ENDPOINT=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
# Vector size of the embedding model. It fixes the vdb.* column type when those
# tables are first created: changing it needs the tables dropped and re-embedded.
# EMBED_DIMENSIONS=2048
# Set to false for a gateway or model that rejects the NVIDIA-only input_type,
# truncate and modality fields (e.g. Amazon Titan behind LiteLLM).
# EMBED_SEND_NIM_PARAMS=true
# Cap on embedding requests in flight per process. Set to 1 if logs show
# "Embedding endpoint returned N vector(s) for N input(s)": the gateway is
# scrambling vector indexes under parallel load.
# EMBED_MAX_CONCURRENT=

# Reranking. The NVIDIA API catalog serves it from ai.api.nvidia.com.
RERANK_ENDPOINT=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-rerank-8b/reranking
RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b
RERANK_API_KEY=nvapi-your-api-key-here

# --- SQL agent: POST /api/sql-agent/query ---
# Required: the route refuses every request until this is set.
# SQL_AGENT_API_KEY=
# Model for the SQL generator, served by REASONING_ENDPOINT.
# SQL_AGENT_GENERATOR_MODEL=qwen.qwen3-coder-480b-a35b-v1:0
# Rows returned to the calling agent, seconds before the tool reports a timeout,
# and how many questions run at once.
# SQL_AGENT_MAX_ROWS=200
# SQL_AGENT_TIMEOUT_S=120
# SQL_AGENT_MAX_CONCURRENT=4
# Times the agent may re-run retrieval when the chosen tables prove insufficient.
# SQL_AGENT_MAX_RENAVIGATIONS=1

# --- Retrieval tuning ---
# Follow the retrieved table's foreign keys to its parent, without its siblings.
HUB_SIBLING_EXPANSION_ENABLED=true
HUB_SIBLING_CAP=0
# Max entities extracted per question for SQL generation and entity coverage.
# SQL_GEN_MAX_ENTITIES=5
# CLARIFICATION_MAX_ENTITIES=10

# --- Compile tuning ---
# Text columns with at most this many distinct values keep their full value set.
LOW_CARDINALITY_MAX=100

# --- LLM invocation (auto_ontology/utils/llm_invoke.py) ---
# Per-call timeout, in seconds.
# LLM_INVOKE_TIMEOUT_S=120
# Max concurrent LLM requests across all worker threads, to stay under the
# hosted endpoint's per-worker request cap (exceeding it surfaces as HTTP 503).
# LLM_MAX_INFLIGHT=6

# --- Ingestion service ---
# Base URL the server uses to trigger an ingest.
# Local: http://localhost:3002  |  Docker compose: http://ingestion-service:3002
INGESTION_SERVICE_URL=http://localhost:3002
# Port the ingestion service listens on.
# INGESTION_PORT=3002
# Ingest scope file; defaults to ingest.yaml at the repo root.
# INGEST_CONFIG_FILE=

# --- HashiCorp Vault (optional) ---
# When all four required vars are set, connection credentials are stored in
# Vault instead of on the catalog row. Partial configuration is ignored.
# VAULT_ADDR=https://vault.example.com
# VAULT_NAMESPACE=your-namespace
# VAULT_ROLE_ID=...
# VAULT_SECRET_ID=...
# Optional mount overrides (defaults shown):
# VAULT_AUTH_MOUNT=approle/nvdcs/dc1
# VAULT_KV_MOUNT=auto-ontology

# --- Review UI login (read by the React UI, not the backend) ---
APP_URL=http://localhost:3000
AUTO_ONTOLOGY_ADMIN_EMAIL=admin@example.com
AUTO_ONTOLOGY_ADMIN_PASSWORD=change-me-please
AUTH_SECRET=change-me-to-a-long-random-string

# Overrides the app version shown in logs (defaults to the installed version).
# APP_VERSION=
